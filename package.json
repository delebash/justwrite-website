    "sync-docs:release": "node scripts/sync-docs.mjs --from release"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.5",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
