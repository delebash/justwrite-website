{
  "name": "justwrite-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-docs.mjs --from local --silent-if-missing",
    "dev": "astro dev",
    "start": "astro dev",
