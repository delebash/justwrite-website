---
const { roman = "VI" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Build-time cache-buster. Astro frontmatter runs once per build, so every
// deploy gets a fresh ?v=… that forces browsers to re-fetch the PNGs even
// when their filenames haven't changed.
const v = Date.now();
const shot = (name) => `${base}/screenshots/${name}?v=${v}`;

// Real screenshots from the app — justwrite-app's e2e/capture-direct.js takes them on the sample
// book, the AI ones with a real local model. Add more files to /public/screenshots/ and append to
// this array.
const shots = [
  {
    file: "home-light.png",
    label: "Home",
    title: "A daily ledger of the work.",
    caption: "Word goal, deadline, the day's session, fortnight, cadence — and a card that drops you back into the chapter you were last in.",
    alt: "JustWrite Home — project goal, today's session, fortnight, cadence",
    span: "wide",
  },
  {
    file: "editor.png",
    label: "Manuscript",
    title: "A typesetter's page.",
    caption: "Write a scene on a quiet serif page, with the manuscript spine on the left. Step back to the chapter's scene cards, read it straight through, or open versions, critique and the multi-reader panel from the chapter.",
    alt: "JustWrite manuscript editor — a scene of the sample novel on a serif page",
    span: "wide",
  },
  {
    file: "scene-draft.png",
    label: "Draft from plan",
    title: "A scene from its summary.",
    caption: "Switch on AI scene drafting for a book, give a scene its summary, and Draft from plan writes it from that and the story around it. The AI's words stay marked in violet until you make them yours.",
    alt: "JustWrite — a scene drafted from its summary, the AI-written words in violet",
    span: "wide",
  },
  {
    file: "characters.png",
    label: "Characters",
    title: "Wants, needs, and the lie they tell.",
    caption: "Each character has wants, needs, the lie they tell themselves, the truth they deny — and a three-act arc. A consistency audit flags contradictions across chapters; a relationship-arc tracker maps how each bond evolves.",
    alt: "JustWrite Characters — protagonist detail with role, one-liner and three-act arc",
    span: "wide",
  },
  {
    file: "name-ideas.png",
    label: "Name ideas",
    title: "Brainstorm where you name things.",
    caption: "Name ideas sits beside every name, Title ideas beside every title. Give it a seed — or none, and the page and the book steer — then Use puts the pick in place.",
    alt: "JustWrite — Name ideas beside a character's name, a seed prompt and a list of names",
    span: "wide",
  },
  {
    file: "talk-to-character.png",
    label: "Talk to a character",
    title: "Interview your cast.",
    caption: "Ask anyone in your story a question and they answer in the voice their sheet gives them, with the scenes behind it cited. Save to sheet puts what you learn back on their page.",
    alt: "JustWrite — a conversation with the protagonist, with cited scenes and Save to sheet",
    span: "wide",
  },
  {
    file: "worldbuilding.png",
    label: "Worldbuilding",
    title: "A wiki for the world around the book.",
    caption: "Free-form articles organised by category — Geography, History, Cultures, Languages, Factions, Magic & lore. Tag them; cross-reference them; search them.",
    alt: "JustWrite Worldbuilding — category filters and articles for the novel's world",
    span: "wide",
  },
  {
    file: "sheet-draft.png",
    label: "Draft with AI",
    title: "A sheet from a sentence.",
    caption: "Describe a place, an object or a group in a line, and the AI drafts its sheet from your words and the book. Tick the fields you want, edit them inline, then apply — fields you've already written stay yours.",
    alt: "JustWrite — a location's sheet drafted from a one-line description, fields to tick and apply",
    span: "wide",
  },
  {
    file: "relations.png",
    label: "Relations",
    title: "Everyone and everything, in one graph.",
    caption: "Characters, locations and objects. The lines come from shared scenes, shared groups and shared strands — you don't draw them here; they appear from the work you do everywhere else.",
    alt: "JustWrite Relations — a graph of the story's characters, places and objects",
    span: "wide",
  },
  {
    file: "plotboard.png",
    label: "Plot board",
    title: "Strands across chapters.",
    caption: "Each narrative strand reads as a row; each chapter a column. Drop a beat on the grid and it links back to its scenes. Templates included — Three-Act, Save the Cat, Hero's Journey, Story Circle — and a strand can suggest its own next beats.",
    alt: "JustWrite Plot board — narrative strands across chapters, with their beats",
    span: "wide",
  },
  {
    file: "timeline.png",
    label: "Timeline",
    title: "The story's chronology, laid flat.",
    caption: "Every event you attach to a character, location, object, group, or the setting — sorted by in-story date. Click an event to edit it; the order reads cleanly even when the chapters don't.",
    alt: "JustWrite Timeline — chronological event list with dates and entity tags",
    span: "wide",
  },
  {
    file: "analysis.png",
    label: "Analysis",
    title: "A reading of the work.",
    caption: "KPIs and a 30-day pace chart up top, then a 53-week heatmap, milestones, status breakdown, narrative strands by word count, words per chapter — and AI readings below for story tension, voice drift, a reverse outline, and plot holes.",
    alt: "JustWrite Analysis — status, strands by word count, words per chapter",
    span: "wide",
  },
  {
    file: "writer-lab.png",
    label: "The Lab",
    title: "Look inside the AI calls.",
    caption: "Every AI feature, opened up: the prompt it sends, the preset it runs on, and a test input to try it against. Run settings side by side and save the one you like as a preset — useful when you're tuning a local model.",
    alt: "JustWrite AI Settings — Routing by feature, a feature's prompt, test input and preset columns",
    span: "wide",
  },
  {
    file: "settings-ai.png",
    label: "AI Settings",
    title: "Bring your own. Plural.",
    caption: "A built-in local engine sized to your graphics card, or any provider you add — Ollama, LM Studio, OpenAI, Claude, Gemini and more. Pick a default, then route each feature to its own model.",
    alt: "JustWrite AI Settings — the computer's hardware and the local providers",
    span: "wide",
  },
  {
    file: "settings-appearance.png",
    label: "Settings · Appearance",
    title: "Theme presets, or tune your own.",
    caption: "Studio, Fine Press, Ivory Press, Calm Modern, Editorial. A live preview pane shows your settings against a real page. Light, dark, or follow the system. Save your mix as a preset.",
    alt: "JustWrite Settings — Appearance theme presets with live preview pane",
    span: "wide",
  },
];
---
<section id="sketches" class="screenshots" data-folio>
  <div class="container">
    <header class="screenshots-head">
      <p class="eyebrow"><span class="roman">{roman}</span><span>Sketches</span></p>
      <h2 class="section-title">From the <em>studio.</em></h2>
      <p class="section-lede">
        Real captures from the working app, against a real novel-in-progress —
        the same rooms, seen from the desk.
      </p>
    </header>

    <div class="gallery">
      {shots.map((s, i) => (
        <figure class={`shot shot--${s.span}`} style={`--i:${i}`}>
          <div class="shot-frame">
            <img src={shot(s.file)} alt={s.alt} loading="lazy" decoding="async" data-zoomable />
          </div>
          <figcaption>
            <span class="cap-label">{s.label}</span>
            <span class="cap-title">{s.title}</span>
            <span class="cap-text">{s.caption}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .screenshots-head { max-width: 56rem; margin-bottom: clamp(3rem, 6vw, 5rem); }

  .gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .shot {
    margin: 0;
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .shot {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    }
    .shot:nth-child(even) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.55fr);
    }
    .shot:nth-child(even) .shot-frame { order: 2; }
    .shot:nth-child(even) figcaption { order: 1; }
  }

  .shot-frame {
    border-radius: var(--r-lg);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    overflow: hidden;
    box-shadow: var(--shadow-2);
    line-height: 0;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .shot-frame:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-window);
    border-color: var(--accent-line);
  }
  .shot-frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    display: flex; flex-direction: column;
    gap: 0.6rem;
    padding: 0 0.25rem;
  }
  .cap-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .cap-title {
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.018em;
    color: var(--ink);
    margin-top: 0.2rem;
  }
  .cap-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 38ch;
  }
</style>
